# wasmtime C API SDK — fetched on demand, not committed
/vendor/

# the compatibility gate's scratch extraction of a previous tag
/.compat/

# private memory (machine facts) — never committed
/cmem/local/

# the session pointer (memory-conventions: gitignored, never authoritative; memory lives in cmem/)
/CLAUDE.md

# wasmtime.dll staged for runtime
/wasmtime.dll

# V build artifacts
*.exe
*.exe~
*.pdb
*.o
*.obj
# the linker's import library / export file for a binary that exports
# uwlv_host_dispatch (written next to it, e.g. examples/uwl_shim.lib)
*.lib
*.exp
/examples/adder
/scripts/zigcc
main
